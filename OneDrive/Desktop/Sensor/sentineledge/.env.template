# SentinelEdge settings for THIS laptop
# (FIRST_TIME_SETUP.bat copies this file to .env.development)

# Database created by FIRST_TIME_SETUP.bat (it puts a random password in the line below)
DATABASE_URL=postgresql://sentineledge:SET_BY_SETUP@localhost:5432/sentineledge

SERVER_PORT=5000
# hub = this laptop has its own Super Admin (normal for a new company laptop)
SERVER_ROLE=hub

# E-mail alerts: nothing is set by default. Add the company's e-mail address and app password in
# Settings > E-mail account for alerts - these two lines are then filled in automatically.
SMTP_USER=
SMTP_PASSWORD=

# SMS alerts through a USB GSM modem (SIM7600), detected automatically
SMS_METHOD=sim7600
